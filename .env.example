# Redis provider API token for redis_cluster_latency_monitor.py
REDIS_API_TOKEN=your-redis-provider-api-token

# Redis connection used by api-gateway
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TOKEN=
REDIS_DIRECT_ENDPOINTS=localhost:6379

# OpenAI token reserved for future experiment summarization/report generation
OPENAI_API_KEY=your-openai-api-key

# Local benchmark defaults
GATEWAY_URL=http://localhost:8080/api/v1/hello
BACKEND_BASE_URL=http://localhost:8081
MOCK_BACKEND_PORT=8081
BENCHMARK_REQUESTS=200
BENCHMARK_CONCURRENCY=20
BACKEND_DELAY_MS=0
BENCHMARK_TIMEOUT_SECONDS=10
BENCHMARK_OUTPUT=latency_report.json
EXPERIMENT_SCENARIOS=baseline,delay-100,delay-500,overload
EXPERIMENT_OUTPUT_DIR=reports
GATEWAY_INTERNAL_REPORT_URL=http://localhost:8080/internal/latency/report
