# API Gateway - Environment Configuration
# Copy to .env and fill in values as needed.
# .env is gitignored and should never be committed.

# ----------------------------------------------------------------
# Backend
# ----------------------------------------------------------------
BACKEND_BASE_URL=http://mock-backend:8081
BACKEND_DELAY_MS=0

# ----------------------------------------------------------------
# Rate limiting
# ----------------------------------------------------------------
# Strategy: in-memory | redis-fixed-window | redis-sliding-window | redis-token-bucket
RATE_LIMIT_STRATEGY=redis-sliding-window

# Requests per minute. Also used as token-bucket capacity.
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60

# Fault policy when Redis is unreachable: fail-closed | fail-open | local-fallback
RATE_LIMIT_REDIS_FAILURE_POLICY=fail-closed

# ----------------------------------------------------------------
# Redis
# ----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TOKEN=
REDIS_DIRECT_ENDPOINTS=localhost:6379

# Redis provider API token for redis_cluster_latency_monitor.py
REDIS_API_TOKEN=your-redis-provider-api-token

# OpenAI token reserved for future report summarization
OPENAI_API_KEY=your-openai-api-key

# ----------------------------------------------------------------
# Gateway URLs
# ----------------------------------------------------------------
GATEWAY_URL=http://localhost:8080/api/v1/hello
GATEWAY_URL_REDIS_SLIDING_WINDOW=http://localhost:8080/api/v1/hello
GATEWAY_URL_REDIS_FIXED_WINDOW=http://localhost:8082/api/v1/hello
GATEWAY_URL_REDIS_TOKEN_BUCKET=http://localhost:8083/api/v1/hello
GATEWAY_URL_IN_MEMORY=http://localhost:8084/api/v1/hello
GATEWAY_INTERNAL_REPORT_URL=http://localhost:8080/internal/latency/report

# ----------------------------------------------------------------
# Benchmark / experiment scripts
# ----------------------------------------------------------------
BENCHMARK_REQUESTS=200
BENCHMARK_CONCURRENCY=20
BENCHMARK_TIMEOUT_SECONDS=10
BENCHMARK_OUTPUT=latency_report.json
BENCHMARK_WARMUP_REQUESTS=0
BENCHMARK_WARMUP_CONCURRENCY=0

EXPERIMENT_STRATEGIES=redis-sliding-window
EXPERIMENT_SCENARIOS=baseline,delay-100,delay-500,overload
EXPERIMENT_OUTPUT_DIR=reports
EXPERIMENT_TRIALS=1
EXPERIMENT_CLIENT_ID_PREFIX=exp
EXPERIMENT_FAULT_POLICIES=fail-closed,fail-open,local-fallback

# Optional: manually override strategy-to-URL if ports differ from defaults.
# EXPERIMENT_STRATEGY_TARGETS=redis-fixed-window=http://localhost:8082/api/v1/hello
# EXPERIMENT_INTERNAL_REPORT_URLS=redis-fixed-window=http://localhost:8082/internal/latency/report

# ----------------------------------------------------------------
# Burst experiment
# ----------------------------------------------------------------
BURST_LABEL=gateway
BURST_SIZE=60
BURST_GAP_MS=400
BURST_PRE_BOUNDARY_MS=200
BURST_CLIENT_ID=
BURST_CLIENT_ID_PREFIX=burst
BURST_OUTPUT=reports/burst/burst_behavior.json
