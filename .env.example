# GateShield local configuration
# Copy to .env for local overrides. Never commit real secrets.

GATESHIELD_ADMIN_TOKEN=change-me
GATEWAY_PORT=8080

# PostgreSQL
POSTGRES_DB=gateshield
POSTGRES_USER=gateshield
POSTGRES_PASSWORD=gateshield
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/gateshield

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TIMEOUT=2000ms
GATESHIELD_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Backend proxy
BACKEND_BASE_URL=http://mock-backend:8081
BACKEND_CONNECT_TIMEOUT_MS=500
BACKEND_READ_TIMEOUT_MS=2000
BACKEND_MAX_ATTEMPTS=1
BACKEND_RETRY_BACKOFF_MS=50
BACKEND_CIRCUIT_BREAKER_ENABLED=true
BACKEND_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
BACKEND_CIRCUIT_BREAKER_RESET_TIMEOUT_MS=5000

# Rate limiting: in-memory | redis-fixed-window | redis-sliding-window | redis-token-bucket
RATE_LIMIT_STRATEGY=redis-sliding-window
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REDIS_FAILURE_POLICY=fail-closed

# Smoke tests and benchmarks
GATEWAY_BASE_URL=http://localhost:8080
GATEWAY_URL=http://localhost:8080/api/v1/hello
GATEWAY_INTERNAL_REPORT_URL=http://localhost:8080/internal/latency/report
BENCHMARK_API_KEY=
BENCHMARK_REQUESTS=200
BENCHMARK_CONCURRENCY=20
BENCHMARK_TIMEOUT_SECONDS=10
BENCHMARK_OUTPUT=reports/latency_report.json
BENCHMARK_WARMUP_REQUESTS=0
BENCHMARK_WARMUP_CONCURRENCY=0

# Optional experiment matrix targets. Enable extra gateway containers with:
# docker compose --profile experiments up --build
GATEWAY_URL_REDIS_SLIDING_WINDOW=http://localhost:8080/api/v1/hello
GATEWAY_URL_REDIS_FIXED_WINDOW=http://localhost:8082/api/v1/hello
GATEWAY_URL_REDIS_TOKEN_BUCKET=http://localhost:8083/api/v1/hello
GATEWAY_URL_IN_MEMORY=http://localhost:8084/api/v1/hello
SCALED_GATEWAY_URL=http://localhost:8100/api/v1/hello
SCALED_RATE_LIMIT_STRATEGY=redis-sliding-window
SCALED_RATE_LIMIT_REDIS_FAILURE_POLICY=local-fallback
