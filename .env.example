# Redis provider API token for redis_cluster_latency_monitor.py
REDIS_API_TOKEN=your-redis-provider-api-token

# Redis connection used by api-gateway
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TOKEN=
REDIS_DIRECT_ENDPOINTS=localhost:6379

# OpenAI token reserved for future experiment summarization/report generation
OPENAI_API_KEY=your-openai-api-key

# Gateway and backend endpoints
BACKEND_BASE_URL=http://localhost:8081
BACKEND_URL=http://localhost:8081/api/v1/hello
GATEWAY_URL=http://localhost:8080/api/v1/hello
GATEWAY_URL_ALT=
GATEWAY_URL_REDIS_SLIDING_WINDOW=http://localhost:8080/api/v1/hello
GATEWAY_URL_REDIS_FIXED_WINDOW=http://localhost:8082/api/v1/hello
GATEWAY_URL_REDIS_TOKEN_BUCKET=http://localhost:8083/api/v1/hello
GATEWAY_URL_IN_MEMORY=http://localhost:8084/api/v1/hello

RATE_LIMIT_STRATEGY=redis-sliding-window
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REDIS_FAILURE_POLICY=fail-closed

# Local benchmark defaults
BENCHMARK_REQUESTS=200
BENCHMARK_CONCURRENCY=20
BENCHMARK_TIMEOUT_SECONDS=10
BENCHMARK_OUTPUT=latency_report.json
EXPERIMENT_SCENARIOS=baseline,delay-100,delay-500,overload
EXPERIMENT_STRATEGIES=redis-sliding-window,redis-fixed-window,redis-token-bucket,in-memory
EXPERIMENT_STRATEGY_TARGETS=redis-sliding-window=http://localhost:8080/api/v1/hello,redis-fixed-window=http://localhost:8082/api/v1/hello,redis-token-bucket=http://localhost:8083/api/v1/hello,in-memory=http://localhost:8084/api/v1/hello
EXPERIMENT_INTERNAL_REPORT_URLS=redis-sliding-window=http://localhost:8080/internal/latency/report,redis-fixed-window=http://localhost:8082/internal/latency/report,redis-token-bucket=http://localhost:8083/internal/latency/report,in-memory=http://localhost:8084/internal/latency/report
EXPERIMENT_OUTPUT_DIR=reports
GATEWAY_INTERNAL_REPORT_URL=http://localhost:8080/internal/latency/report

# Burst experiment defaults
BURST_LABEL=redis-sliding-window
BURST_SIZE=60
BURST_GAP_MS=400
BURST_PRE_BOUNDARY_MS=200
BURST_OUTPUT=reports/burst_behavior.json
